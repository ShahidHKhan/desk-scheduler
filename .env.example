# Gemini API key - used for (1) the pdf_parser.py vision fallback, when a
# submitted PDF is a scan/image with no usable text layer, and (2)
# judge.py, the Step 4 LLM-as-judge that checks infeasibility
# explanations for factual accuracy and clarity.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LangSmith tracing (Step 6/Phase 6) - traces the LangGraph pipeline
# (graph.py) end to end. Picked up automatically by LangGraph/LangSmith
# from these env vars alone - no code changes needed in graph.py itself.
# Get a key at https://smith.langchain.com/settings.
# Leave LANGCHAIN_TRACING_V2 unset/false to run with tracing off (e.g. in
# tests) without needing a key at all.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=service-desk-schedule-optimizer

# SQLite database path (defaults to roster.db if unset - see database.py).
# Used only when DATABASE_URL below is unset.
DATABASE_PATH=roster.db

# Postgres (Supabase) connection string (Phase 7). When set, database.py
# connects here instead of local SQLite - used for the deployed app and for
# manually testing against Supabase. Leave unset for local dev; the pytest
# suite never reads this var and always runs against local SQLite regardless.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Basic auth for the Streamlit app (require_login() in app.py) - gates the
# whole app behind a login form until these match. In production, set as
# Fly secrets (flyctl secrets set APP_USERNAME=... APP_PASSWORD=...), never
# hardcoded or committed.
APP_USERNAME=
APP_PASSWORD=
